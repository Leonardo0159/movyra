// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  // SECURITY: MUST be hashed with bcrypt/argon2 before storage. Never store plain text passwords.
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]

  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  name      String
  avatarUrl String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@map("profiles")
}

model Title {
  id          String   @id @default(uuid())
  type        TitleType
  title       String
  description String?
  releaseYear Int?
  rating      String?
  duration    Int?     // in minutes for movies
  thumbnailUrl String?
  videoUrl    String?  // HLS manifest URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodes Episode[]

  @@map("titles")
}

model Episode {
  id          String   @id @default(uuid())
  titleId     String
  seasonNumber Int
  episodeNumber Int
  name        String
  description String?
  duration    Int?     // in minutes
  videoUrl    String?  // HLS manifest URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@map("episodes")
}

model WatchHistory {
  id        String   @id @default(uuid())
  profileId String
  titleId   String?
  episodeId String?
  progress  Int      @default(0) // in seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("watch_history")
}

enum TitleType {
  MOVIE
  SERIES
  DOCUMENTARY
}
